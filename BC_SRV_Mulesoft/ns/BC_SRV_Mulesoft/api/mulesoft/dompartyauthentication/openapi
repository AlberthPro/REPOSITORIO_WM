              example:
                partyReference:
                  referenceId: A93B64AE1FB376A15EC21132E65B478F
                tokenIdentificationCode:
                  identifierValue:
                    value: TMTM00009A20
                transactionDate:
                - transactionDate: 2024/05/12
                  transactionDateType: TransactionAuthenticationDate
        "400":
