  /v1/token/evaluate:
    post:
      description: Operación que valida un token en gemalto
      operationId: POST_v1-token-evaluate
      parameters:
      - name: consumerRequestId
        in: header
        required: true
        style: simple
        explode: false
        schema:
          type: string
      - name: token
        in: header
        required: true
        style: simple
        explode: false
        schema:
          type: string
      - name: authorization
        in: header
        required: true
        style: simple
        explode: false
