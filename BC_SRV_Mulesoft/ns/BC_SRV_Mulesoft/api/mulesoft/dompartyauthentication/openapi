openapi: 3.0.0
info:
  title: Dom Party Authentication
  version: 1.1.1
servers:
- url: "https://${HOST_NAME}/crossChannel/partyAuthentication"
  variables:
    HOST_NAME:
      default: HOST_NAME
paths:
  /v1/profileFacility/register:
    post:
      description: Realiza un alta del perfil del usuario registrando los valores
        del password y usuario.
      operationId: POST_v1-profileFacility-register
      parameters:
      - name: consumerRequestId
        in: header
        required: true
        style: simple
        explode: false
        schema:
          type: string
      - name: token
        in: header
        required: true
        style: simple
        explode: false
        schema:
          type: string
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/lib.updateProfileRq'
            example:
              profileFacility:
                branch: "2200"
                profileStoredValue: 1
                profileReference: 3
                userCode: C8CF053EF5CE7AD676E6E8C0925FE368
                approveUser: CA51BFDCEC77F2BF342C5194B3695A3C
                password:
                  passwordReference: CA51BFDCEC77F2BF342C5194B3695A3C
                  passwordStoredValue: 9F3F55222E35AAAD8F49EEAF6F089854
                  passwordValidFromToDate:
                    date: 837605DDB5847FE471DD3DD01FEF9443
                    lastUpdateTime: 0B4596F8EFE110DC55BBE564213DFB33
        required: true
      responses:
        "200":
          description: ""
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/lib.updateProfileRs'
              example:
                profileFacility:
                  branch: "2200"
                  profileStoredValue: 1
                  profileReference: 3
                  userCode: C8CF053EF5CE7AD676E6E8C0925FE368
                  approveUser: C8CF053EF5CE7AD676E6E8C0925FE368
                  password:
                    passwordReference: CA51BFDCEC77F2BF342C5194B3695A3C
                    passwordStoredValue: 9F3F55222E35AAAD8F49EEAF6F089854
                    passwordValidFromToDate:
                      date: 837605DDB5847FE471DD3DD01FEF9443
                      lastUpdateTime: 0B4596F8EFE110DC55BBE564213DFB33
        "400":
          description: ""
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/lib.commonErrorRs'
              example:
                statusCode: "400"
                status: FAILED
                message: Bad Request
        "401":
          description: ""
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/lib.commonErrorRs'
              example:
                statusCode: "401"
                status: FAILED
                message: Unauthorized
        "403":
          description: ""
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/lib.commonErrorRs'
              example:
                statusCode: "403"
                status: FAILED
                message: Forbidden
        "404":
          description: ""
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/lib.commonErrorRs'
              example:
                statusCode: "404"
                status: FAILED
                message: Not Found
        "408":
          description: ""
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/lib.commonErrorRs'
              example:
                statusCode: "408"
                status: FAILED
                message: Time Out
        "500":
          description: ""
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/lib.commonErrorRs'
              example:
                statusCode: "500"
                status: FAILED
                message: Internal Server Error
  /v1/partyAuthenticationAssessment/evaluate:
    post:
      description: "Operacion que consulta el valor de la OTP en la tabla OTP, así\
        \ como en el correo electronico de la tabla Email, realizando la comparacion\
        \ para saber si son validas."
      operationId: POST_v1-partyAuthenticationAssessment-evaluate
      parameters:
      - name: consumerRequestId
        in: header
        required: true
        style: simple
        explode: false
        schema:
          type: string
      - name: token
        in: header
        required: true
        style: simple
        explode: false
        schema:
          type: string
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/lib.evaluatePartyAuthenticationAssessmentRq'
            example:
              partyAuthenticationAssessment:
                partyReference:
                  contactPoint:
                  - contactPointValue: SLKN2343TP3NT367LK7KL6543BK2LJND
                  referenceId: 5F600B3C636E509D8B739C57EC1AAA4F
                tokenAssignment:
                  tokenStoredValue: DLKQ4LK6B7LK40F9H20DOIN32LKN
        required: true
      responses:
        "204":
          description: No Content
        "400":
          description: ""
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/lib.commonErrorRs'
              example:
                statusCode: "400"
                status: FAILED
                message: Bad Request
        "401":
          description: ""
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/lib.commonErrorRs'
              example:
                statusCode: "401"
                status: FAILED
                message: Unauthorized
        "403":
          description: ""
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/lib.commonErrorRs'
              example:
                statusCode: "403"
                status: FAILED
                message: Forbidden
        "404":
          description: ""
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/lib.commonErrorRs'
              example:
                statusCode: "404"
                status: FAILED
                message: Not Found
        "408":
          description: ""
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/lib.commonErrorRs'
              example:
                statusCode: "408"
                status: FAILED
                message: Time Out
        "500":
          description: ""
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/lib.commonErrorRs'
              example:
                statusCode: "500"
                status: FAILED
                message: Internal Server Error
  /v1/password/evaluate:
    post:
      description: Operación que valida el pin de una tarjeta de crédito en BPC.
      operationId: POST_v1-password-evaluate
      parameters:
      - name: consumerRequestId
        in: header
        required: true
        style: simple
        explode: false
        schema:
          type: string
      - name: token
        in: header
        required: true
        style: simple
        explode: false
        schema:
          type: string
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/lib.evaluatePasswordRq'
            example:
              paymentCard:
                cardNumber: NDQzNTMzMjM0MzQzNDMyMQ==
              passwordAssignment:
                passwordValue: 464E07AFC9E46359FB480839150595C5
        required: true
      responses:
        "200":
