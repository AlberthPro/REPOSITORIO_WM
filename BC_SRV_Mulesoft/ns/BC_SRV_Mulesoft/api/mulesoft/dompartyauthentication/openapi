components:
  schemas:
    lib.commonErrorRs:
      required:
      - message
      - status
      - statusCode
      type: object
      properties:
        statusCode:
          type: string
          description: codigo de respuesta interno
          example: Example
        message:
          type: string
          description: mensaje de resultado
          example: Example
        status:
          type: string
          description: estado de la peticion
          example: Example
    lib.updateProfileRq:
      $ref: '#/components/schemas/lib.libraryUpdateProfileRq.updateProfileRq'
    lib.updateProfileRs:
      $ref: '#/components/schemas/lib.libraryUpdateProfileRs.updateProfileRs'
    lib.evaluatePartyAuthenticationAssessmentRq:
      $ref: '#/components/schemas/lib.libraryEvaluatePartyAuthenticationAssessmentRq.evaluatePartyAuthenticationAssessmentRq'
    lib.evaluatePasswordRq:
      $ref: '#/components/schemas/lib.libraryEvaluatePasswordRq.evaluatePasswordRq'
    lib.evaluatePasswordRs:
      $ref: '#/components/schemas/lib.libraryEvaluatePasswordRs.evaluatePasswordRs'
    lib.evaluatePasswordPoliciesRq:
      $ref: '#/components/schemas/lib.libraryEvaluatePasswordPoliciesRq.evaluatePasswordPoliciesRq'
    lib.evaluateTokenRq:
      $ref: '#/components/schemas/lib.libraryEvaluateTokenRq.evaluateTokenRq'
    lib.evaluateTokenRs:
      $ref: '#/components/schemas/lib.libraryEvaluateTokenRs.evaluateTokenRs'
    lib.libraryEvaluatePartyAuthenticationAssessmentRq.libraryPartyReference.libraryBirthPlace.birthPlace:
      type: object
      properties:
        location:
          $ref: '#/components/schemas/lib.libraryEvaluatePartyAuthenticationAssessmentRq.libraryPartyReference.libraryLocation.location'
    lib.libraryEvaluatePartyAuthenticationAssessmentRq.libraryPartyReference.libraryContactPoint.contactPoint:
      type: array
      description: Medio utilizado para la comunicación.
      items:
        type: object
        properties:
          contactPointValue:
            type: string
            description: Número telefónico
            x-annotation-lib.libraryEvaluatePartyAuthenticationAssessmentRq.libraryPartyReference.annotation.customControlAttributes:
              kind: AUDITABLE_DATA
          contactPointType:
            type: string
            description: Indica el tipo de punto de contacto * cellphone = numero
              celular * Electronic Address = email * work Phone Number = telefono
              de trabajo * other Phone Number = otro telefono * phone Number = telefono
              residencial
            enum:
            - cellphone
            - Electronic Address
            - phone Number
            - work Phone Number
            - other Phone Number
          contactPointDetail:
            type: string
            description: Detalles sobre el número telefónico ingresado
          contactPointStatus:
            type: string
            description: Indica proceso válido para el numero telefónico
          contactPointActiveStatus:
            type: boolean
            description: Indica el envio exitoso
          contactPointProviderName:
            type: string
            description: Nombre del proovedor de servicio del punto de contacto
    lib.libraryEvaluatePartyAuthenticationAssessmentRq.libraryPartyReference.libraryLocation.libraryCountyDistrict.countyDistrict:
      type: object
      properties:
        name:
          type: string
          description: Nombre del distrito
          x-annotation-lib.libraryEvaluatePartyAuthenticationAssessmentRq.libraryPartyReference.annotation.customControlAttributes:
            kind: AUDITABLE_DATA
        code:
          type: string
          description: Código del distrito
          x-annotation-lib.libraryEvaluatePartyAuthenticationAssessmentRq.libraryPartyReference.annotation.customControlAttributes:
            kind: AUDITABLE_DATA
    lib.libraryEvaluateTokenRq.libraryTokenIdentificationCode.libraryDeviceAssignment.deviceAssignment:
      type: object
      properties:
        issuedDeviceAllocation:
          $ref: '#/components/schemas/lib.libraryEvaluateTokenRq.libraryTokenIdentificationCode.libraryDeviceAssignment.libraryIssuedDeviceAllocation.issuedDeviceAllocation'
        deviceIdentification:
          type: string
          description: Código hash de la huella digital del dispositivo.
        issueLocation:
          $ref: '#/components/schemas/lib.libraryEvaluateTokenRq.libraryTokenIdentificationCode.libraryDeviceAssignment.libraryIssueLocation.issueLocation'
        deviceDescription:
          type: string
          description: Datos adicionales sobre el dispositivo.
        versionNumber:
          type: string
          description: versión del sistema operativo.
        deviceProperty:
          type: object
          properties:
            model:
              type: string
              description: "modelo de dispositivo. Si se omite, se analiza desde el\
                \ agente de usuario."
            sdk:
              type: string
              description: Versión de SDK usada.
        issuedDeviceStatus:
          type: string
          description: '''Estado de la sesión'' * Alive = Sesion Activa * Closed =
            Sesion Cerrada * Deleted = Sesion Eliminada'
          enum:
          - Alive
          - Closed
          - Deleted
        issuedDeviceConfiguration:
          type: string
          description: Configuración estándar de seguridad
        deliveryMethod:
          type: string
          description: Método de entrega del producto.
          enum:
          - WS
          - HALF_AND_HALF
    ? lib.libraryEvaluatePartyAuthenticationAssessmentRq.libraryPartyReference.libraryPersonProfile.libraryEconomicActivity.economicActivity
    : type: object
      properties:
        description:
          type: string
          description: Descripción de la actividad económica.
        code:
          type: string
          description: Código de la actividad económica.
          x-annotation-lib.libraryEvaluatePartyAuthenticationAssessmentRq.libraryPartyReference.annotation.customControlAttributes:
            kind: AUDITABLE_DATA
    lib.libraryEvaluatePartyAuthenticationAssessmentRq.libraryPartyReference.libraryIdentificationDevice.identificationDevice:
      type: object
      properties:
        dateOfBirth:
          type: string
          description: Fecha de nacimiento formato timestamp
        gender:
          type: string
          description: '''El género de la persona obtenido de ocr'' * M = Masculino*
            F = Femenino'
        voterKey:
          maxLength: 18
          minLength: 18
          type: string
          description: Clave de elector como se lee de id. Solo para identificaciones
            mexicanas.
          x-annotation-lib.libraryEvaluatePartyAuthenticationAssessmentRq.libraryPartyReference.annotation.customControlAttributes:
            kind: AUDITABLE_DATA
        curp:
          maxLength: 18
          minLength: 18
          type: string
          description: ID de formulario de lectura. Solo para identificaciones mexicanas.
          x-annotation-lib.libraryEvaluatePartyAuthenticationAssessmentRq.libraryPartyReference.annotation.customControlAttributes:
            kind: AUDITABLE_DATA
        ocr:
          maxLength: 13
          minLength: 13
          type: string
          description: Este campo se lee desde el reverso de la identificación; solo
            para identificaciones mexicanas
          x-annotation-lib.libraryEvaluatePartyAuthenticationAssessmentRq.libraryPartyReference.annotation.customControlAttributes:
            kind: AUDITABLE_DATA
        cic:
          maxLength: 9
          minLength: 9
          type: string
          description: Este campo se lee desde el reverso de la identificación; solo
            para identificaciones mexicanas
          x-annotation-lib.libraryEvaluatePartyAuthenticationAssessmentRq.libraryPartyReference.annotation.customControlAttributes:
            kind: AUDITABLE_DATA
        emissionNumber:
          type: string
          description: Número de emisión.
        expireAt:
          type: string
          description: Fecha de caducidad.
        expirationDate:
          type: string
          description: Año de vencimiento de la identificación.
          x-annotation-lib.libraryEvaluatePartyAuthenticationAssessmentRq.libraryPartyReference.annotation.customControlAttributes:
            kind: AUDITABLE_DATA
        issueDate:
          type: number
          description: Año de emisión de la identificación.
        personName:
          $ref: '#/components/schemas/lib.libraryEvaluatePartyAuthenticationAssessmentRq.libraryPartyReference.libraryPersonName.personName'
        registrationDate:
          type: string
          description: Fecha de registro
          x-annotation-lib.libraryEvaluatePartyAuthenticationAssessmentRq.libraryPartyReference.annotation.customControlAttributes:
            kind: AUDITABLE_DATA
        dateOfBirthCheckDigit:
          type: string
          description: Dígito de verificación de fecha de nacimiento leído de MRZ.
          x-annotation-lib.libraryEvaluatePartyAuthenticationAssessmentRq.libraryPartyReference.annotation.customControlAttributes:
            kind: AUDITABLE_DATA
        documentNumberCheckDigit:
          type: string
          description: Dígito de verificación del número de documento leído de MRZ.
          x-annotation-lib.libraryEvaluatePartyAuthenticationAssessmentRq.libraryPartyReference.annotation.customControlAttributes:
            kind: AUDITABLE_DATA
        expirationDateCheckDigit:
          type: string
          description: Dígito de verificación de fecha de caducidad leído de MRZ.
          x-annotation-lib.libraryEvaluatePartyAuthenticationAssessmentRq.libraryPartyReference.annotation.customControlAttributes:
            kind: AUDITABLE_DATA
        dateofBirthMrz:
          type: string
          description: Dígito de verificación de fecha de nacimiento leído de MRZ.
    lib.libraryEvaluatePartyAuthenticationAssessmentRq.libraryPartyReference.libraryIdentifications.identifications:
      type: array
      items:
        required:
        - identifier
        type: object
        properties:
          identifier:
            type: object
            properties:
              identifierValue:
                type: string
                description: Especifica el valor único del identificador.
                x-annotation-lib.libraryEvaluatePartyAuthenticationAssessmentRq.libraryPartyReference.annotation.customControlAttributes:
                  kind: AUDITABLE_DATA
              issuingAuthority:
                type: string
                description: Nombre de la entidad que emite o proporciona el identificador.
              issuingAuthorityType:
                type: string
                description: Tipo o categoría de la entidad emisora.
              identifierStartDate:
                type: string
                description: Fecha en la que el identificador fue emitido o comenzó
                  a ser válido.
                format: date
              identifierEndDate:
                type: string
                description: Fecha de expiración o finalización de la validez del
                  identificador.
                format: date
              identifierHolderName:
                type: string
                description: Nombre de la persona o entidad que posee o está asociada
                  con el identificador.
          personIdentificationType:
            type: string
            description: '''Indica el tipo de documento de identidad'' * ClaveUnicaRegistroPoblacion
              =  Clave Unica Registro Poblacion * Codigo Cliente = Codigo Cliente  *
              Registro Federal Contribuyentes = Registro Federal Contribuyentes *
              Numero Persona Coppel = Numero Persona Coppel * Documentos Migratorios
              De No Emigrantes = Documentos Migratorios De No Emigrantes  * Codigo
              Identificacion = Codigo Identificacion * Numero Identificacion = Numero
              Identificacion * Numero Identificacion Social = Numero Identificacion
              Social'
            enum:
            - ClaveUnicaRegistroPoblacion
            - Codigo Cliente
            - Registro Federal Contribuyentes
            - Numero Persona Coppel
            - Documentos Migratorios De No Emigrantes
            - Codigo Identificacion
            - Numero Identificacion
            - Numero Identificacion Social
          file:
            type: string
            description: Archivo relacionado con la identificación.
          folioDigit:
            type: string
            description: Dígito del folio asociado.
          provinceDigit:
            type: string
            description: Dígito representativo de la provincia.
          specialIdentDigit:
            type: string
            description: Dígito especial de identificación.
          personDocumentType:
            type: string
            description: Tipo de documento de la persona.
    lib.libraryEvaluateTokenRq.libraryTokenIdentificationCode.libraryDeviceAssignment.libraryIssueLocation.issueLocation:
      type: object
      properties:
        location:
          $ref: '#/components/schemas/lib.libraryEvaluatePartyAuthenticationAssessmentRq.libraryPartyReference.libraryLocation.location'
    ? lib.libraryEvaluateTokenRq.libraryTokenIdentificationCode.libraryDeviceAssignment.libraryIssuedDeviceAllocation.issuedDeviceAllocation
    : type: object
      properties:
        issuedDeviceType:
          type: string
          description: '''Indica la plataforma del dispositivo'' * IOS = IOS * ANDROID
