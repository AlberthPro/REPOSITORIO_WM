      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/lib.evaluateTokenRq'
            example:
              partyReference:
                referenceId: A93B64AE1FB376A15EC21132E65B478F
              tokenIdentificationCode:
                identifierValue:
                  value: TMTM00009A20
              passwordAssignment:
                passwordValue: 464E07AFC9E46359FB480839150595C5
        required: true
      responses:
        "200":
          description: ""
          content:
            application/json:
              schema:
