    <invokeStep Id="ca2ba90d-e569-4d13-bf55-400b8a1862c9"
      description="Dentro del Request neceita:&#xd;&#xa;sessionDialogIdentification + &quot;DOcumentation&quot; del OCR + &quot;Location&quot; del OCR&#xd;&#xa;SI no da error el register documetnation (201) esta correcto&#xd;&#xa;SI hay error 409 salir a OFFICE (exitCOde = 0028) ya es cliente&#xd;&#xa;SI es errorCOde &lt;> 409 entra a loop de reintentos&#xd;&#xa;***&#xd;&#xa;# Rec_registerDocumentation&#xd;&#xa;- request build using Rec_retrieveOcr response&#xd;&#xa;documentation.documentContent.ocrData&#xd;&#xa;documentation.partyReference&#xd;&#xa;documentation.documentContent.ocrData.location[0]&#xd;&#xa;- main mapping&#xd;&#xa;documentation.sessionDialogueIdentification = &lt;sessionDialogueIdentification>&#xd;&#xa;documentation.documentContent.ocrData = &lt;documentation.documentContent.ocrData.*>&#xd;&#xa;documentation.partyReference.location[0] = documentation.documentContent.ocrData.location[0].*&#xd;&#xa;- custom mapping&#xd;&#xa;documentation.documentContent.ocrData.dateTime = LocalDateTime.now().format(&quot;yyyy-MM-dd&quot;)&#xd;&#xa;documentation.documentContent.ocrData.identificationDevice.expirationDate = &lt;identification_device.expiration_date> + &quot;-01-01&quot;&#xd;&#xa;documentation.documentContent.ocrData.identificationDevice.registrationDate = from &quot;2010.0&quot; to &quot;2010-01-01&quot;&#xd;&#xa;documentation.documentContent.ocrData.identificationDevice.nationality = &lt;party_reference.nationality>&#xd;&#xa;documentation.documentContent.ocrData.confidence.* = &lt;ocr>&#xd;&#xa;documentation.documentContent.ocrData.confidence.streetOcrConfidence = 0 // hardcoded&#xd;&#xa;documentation.documentContent.ocrData.confidence.neighborhoodOcrConfidence = 0 // hardcoded&#xd;&#xa;documentation.documentContent.ocrData.confidence.postalCodeOcrConfidence = 0 // hardcoded&#xd;&#xa;documentation.documentContent.ocrData.confidence.stateOcrConfidence = 0 // hardcoded&#xd;&#xa;documentation.partyReference.location[0].locationAddressType = &quot;INE_ADDRESS&quot; // hardcoded&#xd;&#xa;documentation.partyReference.location[0].countyDistrict = &lt;location.city>&#xd;&#xa;documentation.partyReference.location[0].postalCode = &lt;location.postalAddress>&#xd;&#xa;documentation.partyReference.location[0].postalAddress = null&#xd;&#xa;- response analysis &amp; output&#xd;&#xa;200 OK .. CONTINUE&#xd;&#xa;409 FAIL .. OFFICE with IS_ALREADY_CLIENT &quot;0028&quot;&#xd;&#xa;4xx-5xx .. RETRY"
      dynamicReferenceProcess="false" externalizeConditions="false"
      height="60" inputMessageType="Unconfigured"
      invokeContainer="BC_SRV_Apolo.srv.bb_validacionCliente"
      invokeId="BC_SRV_Apolo.srv.bb_validacionCliente:registrarDocumentacionINE"
      invokeLocation="" invokeName="registrarDocumentacionINE"
      invokeType="ISSERVICE" isCompensating="false" isTestAfter="false"
      label="TS.Registrar documentación INE" labelHeight="-1"
