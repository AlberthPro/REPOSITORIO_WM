  <!-- nodes -->

<SEQUENCE NAME="code = 200" EXIT-ON="FAILURE">

  <!-- nodes -->

<MAP MODE="STANDALONE">

  <!-- nodes -->

<MAPCOPY FROM="/response;3;0" TO="/200;2;0">
</MAPCOPY>
</MAP>

<INVOKE SERVICE="pub.flow:clearPipeline">

