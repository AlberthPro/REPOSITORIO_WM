<?xml version="1.0" encoding="UTF-8"?>

<FLOW VERSION="3.0" CLEANUP="true">

  <!-- nodes -->

<SEQUENCE EXIT-ON="FAILURE">

  <!-- nodes -->

<INVOKE SERVICE="wm.server.openapi:invoke">

  <!-- nodes -->

<MAP MODE="INPUT">

  <!-- nodes -->

<MAPSET OVERWRITE="true" VARIABLES="true" GLOBALVARIABLES="false" FIELD="/path;1;0">
  <DATA ENCODING="XMLValues" I18N="true">

<Values version="2.0">
  <value name="xml">/v1/internalCustomerCreditRating/execute</value>
</Values>
</DATA>
</MAPSET>

<MAPSET OVERWRITE="true" VARIABLES="true" GLOBALVARIABLES="false" FIELD="/httpMethod;1;0">
  <DATA ENCODING="XMLValues" I18N="true">

<Values version="2.0">
  <value name="xml">PUT</value>
</Values>
</DATA>
</MAPSET>

<MAPSET OVERWRITE="false" VARIABLES="true" GLOBALVARIABLES="false" FIELD="/radNamespace;1;0">
  <DATA ENCODING="XMLValues" I18N="true">

<Values version="2.0">
  <value name="xml">PD_Pruebas.api.BC_MULESOFT.consumer.customerManagement:customerManagement</value>
</Values>
</DATA>
</MAPSET>
</MAP>

<MAP MODE="OUTPUT">
</MAP>
</INVOKE>

