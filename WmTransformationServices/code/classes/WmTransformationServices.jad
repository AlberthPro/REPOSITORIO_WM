        throws ServiceException
    {
        IDataCursor idatacursor = idata.getCursor();
        Character character = (Character)IDataUtil.get(idatacursor, "input");
        idatacursor.destroy();
        Long long1 = null;
        if(character != null)
            long1 = new Long(character.charValue());
        idatacursor = idata.getCursor();
        IDataUtil.put(idatacursor, "output", long1);
        idatacursor.destroy();
    }

    public static final void UnicodeCharToShort(IData idata)
        throws ServiceException
    {
        IDataCursor idatacursor = idata.getCursor();
        Character character = (Character)IDataUtil.get(idatacursor, "input");
        idatacursor.destroy();
        Short short1 = null;
        if(character != null)
            short1 = new Short((short)character.charValue());
        idatacursor = idata.getCursor();
        IDataUtil.put(idatacursor, "output", short1);
        idatacursor.destroy();
    }

